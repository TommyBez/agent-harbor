<template name="status-glyph" args="failed attention working ready archived">
  <row width="16" height="18" main="center" cross="center">
    <if test="{failed}"><icon name="x-circle" foreground="destructive" width="15" height="15"/></if>
    <else><if test="{attention}"><icon name="alert" foreground="warning" width="15" height="15"/></if>
    <else><if test="{working}"><spinner width="13" height="13"/></if>
    <else><if test="{ready}"><icon name="check-circle" foreground="success" width="15" height="15"/></if>
    <else><if test="{archived}"><icon name="archive" foreground="text_muted" width="15" height="15"/></if>
    <else><icon name="pause" foreground="text_muted" width="15" height="15"/></else></else></else></else></else>
  </row>
</template>
<template name="status-chip" args="failed attention working ready label">
  <row gap="6" cross="center">
    <if test="{failed}"><badge variant="destructive">{label}</badge></if>
    <else><if test="{attention}"><badge accent="warning" accent-foreground="warning_text">{label}</badge></if>
    <else><if test="{working}"><spinner width="12" height="12"/><badge variant="secondary">{label}</badge></if>
    <else><if test="{ready}"><badge accent="success" accent-foreground="success_text">{label}</badge></if>
    <else><badge variant="secondary">{label}</badge></else></else></else></else>
  </row>
</template>
<template name="provider-option" args="name detail initials chosen">
  <row gap="12" cross="center">
    <avatar label="{name}">{initials}</avatar>
    <column grow="1" gap="2">
      <text>{name}</text>
      <text size="sm" foreground="text_muted">{detail}</text>
    </column>
    <if test="{chosen}"><icon name="check-circle" foreground="accent" width="18" height="18"/></if>
  </row>
</template>
<template name="provider-card" args="provider name detail initials chosen">
  <row grow="1">
    <if test="{chosen}">
      <card grow="1" height="68" padding="12" border-color="accent" on-press="choose_provider:{provider}" selected="true" role="button" label="{name}">
        <use template="provider-option" name="{name}" detail="{detail}" initials="{initials}" chosen="true"/>
      </card>
    </if>
    <else>
      <card grow="1" height="68" padding="12" on-press="choose_provider:{provider}" role="button" label="{name}">
        <use template="provider-option" name="{name}" detail="{detail}" initials="{initials}" chosen="false"/>
      </card>
    </else>
  </row>
</template>
<template name="inspector-field" args="title value">
  <column gap="3">
    <text size="sm" foreground="text_muted">{title}</text>
    <text wrap="true">{value}</text>
  </column>
</template>
<template name="feature" args="icon title detail">
  <row gap="12" cross="start">
    <row width="32" height="32" radius="md" background="surface_subtle" main="center" cross="center"><icon name="{icon}" foreground="accent" width="16" height="16"/></row>
    <column grow="1" gap="2">
      <text>{title}</text>
      <text size="sm" wrap="true" foreground="text_muted">{detail}</text>
    </column>
  </row>
</template>
<row grow="1" gap="0">
  <column width="300" gap="0" background="surface_subtle">
    <row height="{headerHeight}" gap="6" cross="center" window-drag="true">
      <spacer width="{chromeLeading}"/>
      <text grow="1" foreground="text_muted">Agent Harbor</text>
      <stack>
        <button size="sm" variant="ghost" icon="plus" label="New session" on-press="new_session" disabled="{busy}"/>
        <tooltip anchor="below">New session · Cmd+N</tooltip>
      </stack>
      <spacer width="10"/>
    </row>
    <column padding="12" gap="10">
      <search-field text="{searchText}" placeholder="Search sessions or projects" on-input="search_edit" autofocus="{search_focus}"/>
      <tabs label="Scope">
        <button size="sm" selected="{scopeAll}" on-press="filter_all">Sessions · {allCount}</button>
        <button size="sm" selected="{scopeArchived}" on-press="filter_archived">Archive · {archivedCount}</button>
      </tabs>
    </column>
    <scroll grow="1" key="session-scroll">
      <column gap="2" padding="8">
        <for each="visible" key="id" as="r">
          <if test="{r.header}">
            <row gap="6" cross="center" padding="6" on-press="toggle_group:{r.group}" role="button" label="{r.heading}" radius="sm">
              <if test="{r.collapsed}"><icon name="chevron-right" foreground="text_muted" width="12" height="12"/></if>
              <else><icon name="chevron-down" foreground="text_muted" width="12" height="12"/></else>
              <text size="sm" foreground="text_muted">{upper(r.heading)}</text>
            </row>
          </if>
          <else>
            <list-item padding="8" gap="10" cross="start" selected="{r.selected}" on-press="select:{r.id}" label="{r.title}">
              <use template="status-glyph" failed="{r.failed}" attention="{r.attention}" working="{r.working}" ready="{r.ready}" archived="{r.archived}"/>
              <column grow="1" gap="3">
                <row gap="8" cross="center">
                  <text grow="1">{r.title}</text>
                  <text size="sm" foreground="text_muted">{r.when}</text>
                </row>
                <row gap="6" cross="center" height="18">
                  <if test="{r.failed}"><text size="sm" foreground="destructive">{r.status}</text></if>
                  <else><if test="{r.working}"><text size="sm" foreground="accent">{r.status}</text></if>
                  <else><if test="{r.ready}"><text size="sm" foreground="success">{r.status}</text></if></else></else>
                  <text size="sm" foreground="text_muted" grow="1">{r.meta}</text>
                  <if test="{r.grok}"><badge variant="secondary" foreground="info">Grok</badge></if>
                </row>
              </column>
              <context-menu>
                <menu-item on-press="row_rename:{r.id}">Rename</menu-item>
                <if test="{r.grok}"><menu-item on-press="row_take:{r.id}">Take control</menu-item></if>
                <else><menu-item on-press="row_release:{r.id}">Hand to Grok</menu-item></else>
                <if test="{r.alive}"><menu-item on-press="row_terminal:{r.id}">Open in Terminal</menu-item></if>
                <menu-item on-press="row_copy:{r.id}">Copy conversation ID</menu-item>
                <separator/>
                <if test="{r.alive}"><menu-item on-press="row_stop:{r.id}">Close CLI</menu-item></if>
                <else>
                  <if test="{r.archived}"><menu-item on-press="row_restore:{r.id}">Restore from archive</menu-item></if>
                  <else>
                    <menu-item on-press="row_start:{r.id}">Resume session</menu-item>
                    <menu-item on-press="row_archive:{r.id}">Archive</menu-item>
                  </else>
                </else>
              </context-menu>
            </list-item>
          </else>
        </for>
        <else>
          <column padding="16" gap="8" cross="center">
            <text foreground="text_muted">{emptyTitle}</text>
            <text size="sm" wrap="true" text-alignment="center" foreground="text_muted">{emptyHint}</text>
            <if test="{searching}"><button size="sm" variant="outline" on-press="clear_search">Clear search</button></if>
          </column>
        </else>
      </column>
    </scroll>
    <separator/>
    <column padding="12" gap="10">
      <if test="{showNotice}">
        <row gap="8" cross="start">
          <if test="{noticeSuccess}"><icon name="check-circle" foreground="success" width="14" height="14"/></if>
          <else><icon name="info" foreground="text_muted" width="14" height="14"/></else>
          <text size="sm" wrap="true" grow="1">{notice}</text>
        </row>
      </if>
      <row gap="6" cross="center">
        <if test="{connected}"><icon name="circle-dot" foreground="success" width="12" height="12"/></if>
        <else><spinner width="12" height="12"/></else>
        <text size="sm" foreground="text_muted" grow="1">{connection}</text>
        <if test="{showPager}">
          <text size="sm" foreground="text_muted">{pageLabel}</text>
          <button size="sm" variant="ghost" icon="chevron-left" label="Previous page" disabled="{firstPage}" on-press="previous_page"/>
          <button size="sm" variant="ghost" icon="chevron-right" label="Next page" disabled="{lastPage}" on-press="next_page"/>
        </if>
        <else><text size="sm" foreground="text_muted">{listSummary}</text></else>
      </row>
    </column>
  </column>
  <separator/>
  <column grow="1" gap="0" background="background">
    <if test="{showFailure}">
      <row padding="12" gap="10" cross="center" background="surface">
        <icon name="x-circle" foreground="destructive" width="16" height="16"/>
        <text grow="1" wrap="true">{notice}</text>
        <button size="sm" variant="ghost" icon="x" label="Dismiss" on-press="dismiss_notice"/>
      </row>
      <separator/>
    </if>
    <if test="{creating}">
      <row height="{headerHeight}" gap="10" cross="center" window-drag="true" background="surface">
        <spacer width="20"/>
        <text size="lg" grow="1">New session</text>
        <button size="sm" variant="ghost" on-press="cancel_form" disabled="{busy}">Cancel</button>
        <spacer width="14"/>
      </row>
      <separator/>
      <scroll grow="1">
        <column padding="32" cross="center">
          <column width="640" gap="24">
            <text wrap="true" foreground="text_muted">Choose the agent and the project. Every session keeps its own conversation, even after you close the window.</text>
            <column gap="8">
              <text>Agent</text>
              <row gap="12">
                <use template="provider-card" provider="claude" name="Claude Code" detail="Anthropic's interactive CLI" initials="CC" chosen="{form_claude}"/>
                <use template="provider-card" provider="codex" name="Codex" detail="OpenAI's interactive CLI" initials="CX" chosen="{formCodex}"/>
              </row>
            </column>
            <column gap="8">
              <text>Project folder</text>
              <row gap="8">
                <text-field grow="1" text="{formProject}" placeholder="Local project path" on-input="project_edit"/>
                <button icon="folder-open" on-press="choose_folder">Choose folder</button>
              </row>
              <if test="{hasRecentProjects}">
                <row gap="6" cross="center">
                  <text size="sm" foreground="text_muted">Recent</text>
                  <for each="recentProjects" key="path" as="p">
                    <button size="sm" variant="outline" icon="folder" on-press="pick_project:{p.path}">{p.name}</button>
                  </for>
                </row>
              </if>
            </column>
            <column gap="8">
              <text>Session name · optional</text>
              <text-field text="{formTitle}" placeholder="{titlePlaceholder}" on-input="title_edit" autofocus="true"/>
            </column>
            <column gap="8">
              <text>First task · optional</text>
              <textarea height="150" text="{formPrompt}" placeholder="What should the agent do?" on-input="prompt_edit" on-submit="create_session"/>
              <text size="sm" foreground="text_muted">Cmd+Enter starts the session. Without a task, the agent only confirms it is ready.</text>
            </column>
            <accordion text="Launch options" selected="{advanced}" on-toggle="toggle_advanced">
              <column gap="8">
                <textarea height="96" text="{formCliArgs}" placeholder="JSON array of arguments" on-input="cli_args_edit"/>
                <text size="sm" foreground="text_muted" wrap="true">For example ["--model", "model-name"]. Each argument reaches the CLI as literal text and is kept on resume.</text>
              </column>
            </accordion>
            <if test="{formHasTruncation}"><text foreground="destructive">Text too long. Shorten it before continuing.</text></if>
            <separator/>
            <row gap="12" cross="center">
              <icon name="info" foreground="text_muted" width="14" height="14"/>
              <text size="sm" grow="1" wrap="true" foreground="text_muted">Starts under your control. Trust questions appear in Harbor; permission prompts stay in the terminal.</text>
              <button variant="primary" icon="play" disabled="{cannotCreate}" on-press="create_session">Create and start</button>
            </row>
          </column>
        </column>
      </scroll>
    </if>
    <else>
      <if test="{hasSelection}">
        <row height="{headerHeight}" gap="8" cross="center" window-drag="true" background="surface">
          <spacer width="20"/>
          <if test="{renaming}">
            <text-field grow="1" size="sm" text="{renameText}" on-input="rename_edit" on-submit="save_name" placeholder="New name" autofocus="true"/>
            <button size="sm" variant="primary" on-press="save_name" disabled="{cannotSaveName}">Save</button>
            <button size="sm" variant="ghost" on-press="cancel_name">Cancel rename</button>
          </if>
          <else>
            <column grow="1" gap="1">
              <text size="lg">{selectedTitle}</text>
              <text size="sm" foreground="text_muted">{selectedSubtitle}</text>
            </column>
            <use template="status-chip" failed="{selFailed}" attention="{attention}" working="{selWorking}" ready="{selReady}" label="{selectedStatus}"/>
            <if test="{showControl}">
              <spacer width="4"/>
              <toggle-group gap="0" label="Session control">
                <button size="sm" selected="{human}" disabled="{cannotTake}" on-press="take_control" label="{humanSegment}">You</button>
                <button size="sm" selected="{grok}" disabled="{cannotGrokSegment}" on-press="release_control" label="{grokSegment}">Grok</button>
              </toggle-group>
              <spacer width="4"/>
            </if>
            <button size="sm" variant="ghost" icon="edit" label="Rename session" on-press="rename_session"/>
            <if test="{alive}"><button size="sm" variant="ghost" icon="external-link" label="Open in Terminal" disabled="{busy}" on-press="open_terminal"/></if>
            <button size="sm" variant="ghost" icon="info" label="Session details" selected="{details}" on-press="show_details"/>
            <if test="{alive}"><button size="sm" variant="outline" icon="pause" disabled="{cannotStop}" on-press="stop_session">Close CLI</button></if>
          </else>
          <spacer width="14"/>
        </row>
        <separator/>
        <if test="{attention}">
          <row padding="14" gap="12" cross="center" background="surface">
            <column width="3" height="34" radius="sm" background="warning"/>
            <icon name="alert" foreground="warning" width="18" height="18"/>
            <column grow="1" gap="2">
              <text>{attentionTitle}</text>
              <if test="{trustNeeded}"><text size="sm" wrap="true">{trustFolder}</text></if>
              <text size="sm" wrap="true" foreground="text_muted">{attentionHint}</text>
            </column>
            <if test="{trustNeeded}">
              <if test="{canTrustParent}">
                <stack>
                  <button size="sm" disabled="{busy}" on-press="trust_parent">Always trust {trustParentName}</button>
                  <tooltip anchor="below">New projects in this folder will start without asking</tooltip>
                </stack>
              </if>
              <button size="sm" variant="primary" disabled="{busy}" on-press="trust_folder">{trustAction}</button>
            </if>
            <else><if test="{grok}"><button size="sm" variant="primary" disabled="{busy}" on-press="take_control">Take control</button></if></else>
          </row>
          <separator/>
        </if>
        <else>
          <if test="{showGrokBanner}">
            <row padding="14" gap="12" cross="center" background="surface">
              <column width="3" height="34" radius="sm" background="info"/>
              <icon name="eye" foreground="info" width="18" height="18"/>
              <column grow="1" gap="2">
                <text>Grok has control</text>
                <text size="sm" wrap="true" foreground="text_muted">You're observing: the terminal is read-only until you take control.</text>
              </column>
              <button size="sm" variant="primary" disabled="{busy}" on-press="take_control">Take control</button>
            </row>
            <separator/>
          </if>
          <if test="{showControlHint}">
            <row padding="10" gap="10" cross="center" background="surface">
              <spinner width="12" height="12"/>
              <text size="sm" grow="1" foreground="text_muted">{controlHint}</text>
            </row>
            <separator/>
          </if>
        </else>
        <row grow="1" gap="0">
          <if test="{terminalVisible}">
            <column grow="1" padding="10">
              <terminal key="agent-terminal" pty="{ptyKey}" scrollback="{scrollback}" grow="1" label="Session terminal" on-terminal="terminal_state" autofocus="{focus_terminal}"/>
            </column>
          </if>
          <else>
            <column grow="1" padding="40" main="center" cross="center">
              <column width="460" gap="14" cross="center">
                <if test="{archived}">
                  <row width="56" height="56" radius="xl" background="surface_subtle" main="center" cross="center"><icon name="archive" foreground="text_muted" width="26" height="26"/></row>
                  <text size="heading">Archived session</text>
                  <text wrap="true" text-alignment="center" foreground="text_muted">The conversation is saved. Restore it to pick up from the same point.</text>
                  <button icon="archive" variant="primary" on-press="restore_session" disabled="{busy}">Restore from archive</button>
                </if>
                <else>
                  <row width="56" height="56" radius="xl" background="surface_subtle" main="center" cross="center"><icon name="pause" foreground="text_muted" width="26" height="26"/></row>
                  <text size="heading">Session closed</text>
                  <if test="{human}">
                    <text wrap="true" text-alignment="center" foreground="text_muted">The conversation is saved. Resume it to continue exactly where it stopped.</text>
                    <row gap="8">
                      <button icon="play" variant="primary" disabled="{cannotStart}" on-press="start_session">Resume session</button>
                      <button icon="archive" variant="ghost" disabled="{busy}" on-press="archive_session">Archive</button>
                    </row>
                  </if>
                  <else>
                    <text wrap="true" text-alignment="center" foreground="text_muted">Grok has control of this session. Take control to resume it yourself.</text>
                    <row gap="8">
                      <button variant="primary" disabled="{busy}" on-press="take_control">Take control</button>
                      <button icon="play" variant="outline" disabled="{cannotStart}" on-press="start_session">Resume session</button>
                    </row>
                  </else>
                </else>
                <text size="sm" foreground="text_muted">{closedMeta}</text>
              </column>
            </column>
          </else>
          <if test="{detailsVisible}">
            <separator/>
            <scroll width="300">
              <column padding="18" gap="16">
                <row cross="center"><text grow="1">Details</text><button size="sm" variant="ghost" icon="x" label="Close details" on-press="show_details"/></row>
                <column gap="6">
                  <text size="sm" foreground="text_muted">Original conversation</text>
                  <text><span mono="true">{nativeId}</span></text>
                  <if test="{hasNativeId}"><button size="sm" variant="outline" icon="copy" on-press="copy_id">Copy ID</button></if>
                </column>
                <column gap="6">
                  <text size="sm" foreground="text_muted">Harbor session</text>
                  <text><span mono="true">{selectedId}</span></text>
                </column>
                <use template="inspector-field" title="Agent" value="{selectedProvider}"/>
                <use template="inspector-field" title="Working directory" value="{selectedProject}"/>
                <use template="inspector-field" title="Control" value="{controlLabel}"/>
                <use template="inspector-field" title="Process" value="{pidLabel}"/>
                <use template="inspector-field" title="Run" value="{runLabel}"/>
                <use template="inspector-field" title="Created" value="{createdLabel}"/>
                <use template="inspector-field" title="Last update" value="{updatedLabel}"/>
                <if test="{hasErrorCode}"><use template="inspector-field" title="Last signal" value="{errorCode}"/></if>
                <if test="{alive}"><button size="sm" variant="outline" icon="refresh-cw" on-press="reconnect">Reconnect terminal</button></if>
                <separator/>
                <text size="sm" wrap="true" foreground="text_muted">Open in Terminal uses the same CLI and context, including advanced input features. Closing the window does not stop sessions.</text>
              </column>
            </scroll>
          </if>
        </row>
      </if>
      <else>
        <row height="{headerHeight}" window-drag="true" background="background"><spacer grow="1"/></row>
        <scroll grow="1">
          <column grow="1" padding="40" main="center" cross="center">
            <if test="{showWelcome}">
              <column width="580" gap="26">
                <column gap="10">
                  <row width="48" height="48" radius="xl" background="surface_subtle" main="center" cross="center"><icon name="terminal" foreground="accent" width="24" height="24"/></row>
                  <text size="heading">Work keeps going, even with the window closed</text>
                  <text wrap="true" foreground="text_muted">Start Claude Code or Codex in a persistent session, follow the work and hand control to Grok whenever you like.</text>
                </column>
                <row gap="12">
                  <card grow="1" height="72" padding="14" on-press="new_claude" role="button" label="New session with Claude Code">
                    <row gap="12" cross="center"><avatar label="Claude Code">CC</avatar><column grow="1" gap="2"><text>Claude Code</text><text size="sm" foreground="text_muted">New session</text></column><icon name="arrow-right" foreground="text_muted" width="16" height="16"/></row>
                  </card>
                  <card grow="1" height="72" padding="14" on-press="new_codex" role="button" label="New session with Codex">
                    <row gap="12" cross="center"><avatar label="Codex">CX</avatar><column grow="1" gap="2"><text>Codex</text><text size="sm" foreground="text_muted">New session</text></column><icon name="arrow-right" foreground="text_muted" width="16" height="16"/></row>
                  </card>
                </row>
                <column gap="14">
                  <use template="feature" icon="refresh-cw" title="Resume the exact conversation" detail="Every session resumes its own original conversation, never just the latest one."/>
                  <use template="feature" icon="send" title="Hand control to Grok" detail="Watch the bot work and take control back at any time."/>
                  <use template="feature" icon="eye" title="Grok's sessions show up here" detail="Sessions the bot starts join this list automatically."/>
                </column>
                <text size="sm" foreground="text_muted">Cmd+N new session · Cmd+F search · Cmd+1-9 open · Cmd+Option+arrows switch session</text>
              </column>
            </if>
            <else>
              <column gap="12" cross="center" padding="80">
                <spinner width="22" height="22"/>
                <text foreground="text_muted">{placeholderText}</text>
              </column>
            </else>
          </column>
        </scroll>
      </else>
    </else>
  </column>
</row>
