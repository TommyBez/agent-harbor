<template name="status-glyph" args="failed attention working ready archived">
  <row width="16" height="18" main="center" cross="center">
    <if test="{failed}"><icon name="x-circle" foreground="destructive" width="15" height="15"/></if>
    <else><if test="{attention}"><icon name="alert" foreground="warning" width="15" height="15"/></if>
    <else><if test="{working}"><spinner width="13" height="13"/></if>
    <else><if test="{ready}"><icon name="check-circle" foreground="success" width="15" height="15"/></if>
    <else><if test="{archived}"><icon name="archive" foreground="text_muted" width="15" height="15"/></if>
    <else><icon name="pause" foreground="text_muted" width="15" height="15"/></else></else></else></else></else>
  </row>
</template>
<template name="status-chip" args="failed attention working ready label">
  <row gap="6" cross="center">
    <if test="{failed}"><badge variant="destructive">{label}</badge></if>
    <else><if test="{attention}"><badge accent="warning" accent-foreground="warning_text">{label}</badge></if>
    <else><if test="{working}"><spinner width="12" height="12"/><badge variant="secondary">{label}</badge></if>
    <else><if test="{ready}"><badge accent="success" accent-foreground="success_text">{label}</badge></if>
    <else><badge variant="secondary">{label}</badge></else></else></else></else>
  </row>
</template>
<template name="provider-option" args="name detail initials chosen">
  <row gap="12" cross="center">
    <avatar label="{name}">{initials}</avatar>
    <column grow="1" gap="2">
      <text>{name}</text>
      <text size="sm" foreground="text_muted">{detail}</text>
    </column>
    <if test="{chosen}"><icon name="check-circle" foreground="accent" width="18" height="18"/></if>
  </row>
</template>
<template name="provider-card" args="provider name detail initials chosen">
  <row grow="1">
    <if test="{chosen}">
      <card grow="1" height="68" padding="12" border-color="accent" on-press="choose_provider:{provider}" selected="true" role="button" label="{name}">
        <use template="provider-option" name="{name}" detail="{detail}" initials="{initials}" chosen="true"/>
      </card>
    </if>
    <else>
      <card grow="1" height="68" padding="12" on-press="choose_provider:{provider}" role="button" label="{name}">
        <use template="provider-option" name="{name}" detail="{detail}" initials="{initials}" chosen="false"/>
      </card>
    </else>
  </row>
</template>
<template name="inspector-field" args="title value">
  <column gap="3">
    <text size="sm" foreground="text_muted">{title}</text>
    <text wrap="true">{value}</text>
  </column>
</template>
<template name="feature" args="icon title detail">
  <row gap="12" cross="start">
    <row width="32" height="32" radius="md" background="surface_subtle" main="center" cross="center"><icon name="{icon}" foreground="accent" width="16" height="16"/></row>
    <column grow="1" gap="2">
      <text>{title}</text>
      <text size="sm" wrap="true" foreground="text_muted">{detail}</text>
    </column>
  </row>
</template>
<row grow="1" gap="0">
  <column width="300" gap="0" background="surface_subtle">
    <row height="{headerHeight}" gap="6" cross="center" window-drag="true">
      <spacer width="{chromeLeading}"/>
      <text grow="1" foreground="text_muted">Agent Harbor</text>
      <stack>
        <button size="sm" variant="ghost" icon="plus" label="Nuova sessione" on-press="new_session" disabled="{busy}"/>
        <tooltip anchor="below">Nuova sessione · Cmd+N</tooltip>
      </stack>
      <spacer width="10"/>
    </row>
    <column padding="12" gap="10">
      <search-field text="{searchText}" placeholder="Cerca sessione o progetto" on-input="search_edit" autofocus="{search_focus}"/>
      <tabs label="Ambito">
        <button size="sm" selected="{scopeAll}" on-press="filter_all">Sessioni · {allCount}</button>
        <button size="sm" selected="{scopeArchived}" on-press="filter_archived">Archivio · {archivedCount}</button>
      </tabs>
    </column>
    <scroll grow="1" key="session-scroll">
      <column gap="2" padding="8">
        <for each="visible" key="id" as="r">
          <if test="{r.header}">
            <row gap="6" cross="center" padding="6" on-press="toggle_group:{r.group}" role="button" label="{r.heading}" radius="sm">
              <if test="{r.collapsed}"><icon name="chevron-right" foreground="text_muted" width="12" height="12"/></if>
              <else><icon name="chevron-down" foreground="text_muted" width="12" height="12"/></else>
              <text size="sm" foreground="text_muted">{upper(r.heading)}</text>
            </row>
          </if>
          <else>
            <list-item padding="8" gap="10" cross="start" selected="{r.selected}" on-press="select:{r.id}" label="{r.title}">
              <use template="status-glyph" failed="{r.failed}" attention="{r.attention}" working="{r.working}" ready="{r.ready}" archived="{r.archived}"/>
              <column grow="1" gap="3">
                <row gap="8" cross="center">
                  <text grow="1">{r.title}</text>
                  <text size="sm" foreground="text_muted">{r.when}</text>
                </row>
                <row gap="6" cross="center" height="18">
                  <if test="{r.failed}"><text size="sm" foreground="destructive">{r.status}</text></if>
                  <else><if test="{r.working}"><text size="sm" foreground="accent">{r.status}</text></if>
                  <else><if test="{r.ready}"><text size="sm" foreground="success">{r.status}</text></if></else></else>
                  <text size="sm" foreground="text_muted" grow="1">{r.meta}</text>
                  <if test="{r.grok}"><badge variant="secondary" foreground="info">Grok</badge></if>
                </row>
              </column>
              <context-menu>
                <menu-item on-press="row_rename:{r.id}">Rinomina</menu-item>
                <if test="{r.grok}"><menu-item on-press="row_take:{r.id}">Prendi il controllo</menu-item></if>
                <else><menu-item on-press="row_release:{r.id}">Passa a Grok</menu-item></else>
                <if test="{r.alive}"><menu-item on-press="row_terminal:{r.id}">Apri in Terminale</menu-item></if>
                <menu-item on-press="row_copy:{r.id}">Copia ID conversazione</menu-item>
                <separator/>
                <if test="{r.alive}"><menu-item on-press="row_stop:{r.id}">Chiudi CLI</menu-item></if>
                <else>
                  <if test="{r.archived}"><menu-item on-press="row_restore:{r.id}">Ripristina dall'archivio</menu-item></if>
                  <else>
                    <menu-item on-press="row_start:{r.id}">Riprendi sessione</menu-item>
                    <menu-item on-press="row_archive:{r.id}">Archivia</menu-item>
                  </else>
                </else>
              </context-menu>
            </list-item>
          </else>
        </for>
        <else>
          <column padding="16" gap="8" cross="center">
            <text foreground="text_muted">{emptyTitle}</text>
            <text size="sm" wrap="true" text-alignment="center" foreground="text_muted">{emptyHint}</text>
            <if test="{searching}"><button size="sm" variant="outline" on-press="clear_search">Cancella ricerca</button></if>
          </column>
        </else>
      </column>
    </scroll>
    <separator/>
    <column padding="12" gap="10">
      <if test="{showNotice}">
        <row gap="8" cross="start">
          <if test="{noticeSuccess}"><icon name="check-circle" foreground="success" width="14" height="14"/></if>
          <else><icon name="info" foreground="text_muted" width="14" height="14"/></else>
          <text size="sm" wrap="true" grow="1">{notice}</text>
        </row>
      </if>
      <row gap="6" cross="center">
        <if test="{connected}"><icon name="circle-dot" foreground="success" width="12" height="12"/></if>
        <else><spinner width="12" height="12"/></else>
        <text size="sm" foreground="text_muted" grow="1">{connection}</text>
        <if test="{showPager}">
          <text size="sm" foreground="text_muted">{pageLabel}</text>
          <button size="sm" variant="ghost" icon="chevron-left" label="Pagina precedente" disabled="{firstPage}" on-press="previous_page"/>
          <button size="sm" variant="ghost" icon="chevron-right" label="Pagina successiva" disabled="{lastPage}" on-press="next_page"/>
        </if>
        <else><text size="sm" foreground="text_muted">{listSummary}</text></else>
      </row>
    </column>
  </column>
  <separator/>
  <column grow="1" gap="0" background="background">
    <if test="{showFailure}">
      <row padding="12" gap="10" cross="center" background="surface">
        <icon name="x-circle" foreground="destructive" width="16" height="16"/>
        <text grow="1" wrap="true">{notice}</text>
        <button size="sm" variant="ghost" icon="x" label="Chiudi avviso" on-press="dismiss_notice"/>
      </row>
      <separator/>
    </if>
    <if test="{creating}">
      <row height="{headerHeight}" gap="10" cross="center" window-drag="true" background="surface">
        <spacer width="20"/>
        <text size="lg" grow="1">Nuova sessione</text>
        <button size="sm" variant="ghost" on-press="cancel_form" disabled="{busy}">Annulla</button>
        <spacer width="14"/>
      </row>
      <separator/>
      <scroll grow="1">
        <column padding="32" cross="center">
          <column width="640" gap="24">
            <text wrap="true" foreground="text_muted">Scegli l'agente e il progetto. Ogni sessione conserva la propria conversazione, anche quando chiudi la finestra.</text>
            <column gap="8">
              <text>Agente</text>
              <row gap="12">
                <use template="provider-card" provider="claude" name="Claude Code" detail="CLI interattiva di Anthropic" initials="CC" chosen="{form_claude}"/>
                <use template="provider-card" provider="codex" name="Codex" detail="CLI interattiva di OpenAI" initials="CX" chosen="{formCodex}"/>
              </row>
            </column>
            <column gap="8">
              <text>Cartella del progetto</text>
              <row gap="8">
                <text-field grow="1" text="{formProject}" placeholder="Percorso del progetto locale" on-input="project_edit"/>
                <button icon="folder-open" on-press="choose_folder">Scegli cartella</button>
              </row>
              <if test="{hasRecentProjects}">
                <row gap="6" cross="center">
                  <text size="sm" foreground="text_muted">Recenti</text>
                  <for each="recentProjects" key="path" as="p">
                    <button size="sm" variant="outline" icon="folder" on-press="pick_project:{p.path}">{p.name}</button>
                  </for>
                </row>
              </if>
            </column>
            <column gap="8">
              <text>Nome della sessione · facoltativo</text>
              <text-field text="{formTitle}" placeholder="{titlePlaceholder}" on-input="title_edit" autofocus="true"/>
            </column>
            <column gap="8">
              <text>Primo compito · facoltativo</text>
              <textarea height="150" text="{formPrompt}" placeholder="Cosa deve fare l'agente?" on-input="prompt_edit" on-submit="create_session"/>
              <text size="sm" foreground="text_muted">Cmd+Invio avvia la sessione. Senza compito, l'agente conferma solo di essere pronto.</text>
            </column>
            <accordion text="Opzioni di avvio" selected="{advanced}" on-toggle="toggle_advanced">
              <column gap="8">
                <textarea height="96" text="{formCliArgs}" placeholder="Array JSON di argomenti" on-input="cli_args_edit"/>
                <text size="sm" foreground="text_muted" wrap="true">Per esempio ["--model", "nome-modello"]. Ogni argomento passa alla CLI come testo e si conserva nelle riprese.</text>
              </column>
            </accordion>
            <if test="{formHasTruncation}"><text foreground="destructive">Testo troppo lungo. Riducilo prima di continuare.</text></if>
            <separator/>
            <row gap="12" cross="center">
              <icon name="info" foreground="text_muted" width="14" height="14"/>
              <text size="sm" grow="1" wrap="true" foreground="text_muted">Parte con il tuo controllo. Le richieste di fiducia e autorizzazione restano nel terminale.</text>
              <button variant="primary" icon="play" disabled="{cannotCreate}" on-press="create_session">Crea e avvia</button>
            </row>
          </column>
        </column>
      </scroll>
    </if>
    <else>
      <if test="{hasSelection}">
        <row height="{headerHeight}" gap="8" cross="center" window-drag="true" background="surface">
          <spacer width="20"/>
          <if test="{renaming}">
            <text-field grow="1" size="sm" text="{renameText}" on-input="rename_edit" on-submit="save_name" placeholder="Nuovo nome" autofocus="true"/>
            <button size="sm" variant="primary" on-press="save_name" disabled="{cannotSaveName}">Salva</button>
            <button size="sm" variant="ghost" on-press="cancel_name">Annulla nome</button>
          </if>
          <else>
            <column grow="1" gap="1">
              <text size="lg">{selectedTitle}</text>
              <text size="sm" foreground="text_muted">{selectedSubtitle}</text>
            </column>
            <use template="status-chip" failed="{selFailed}" attention="{attention}" working="{selWorking}" ready="{selReady}" label="{selectedStatus}"/>
            <if test="{showControl}">
              <spacer width="4"/>
              <toggle-group gap="0" label="Controllo della sessione">
                <button size="sm" selected="{human}" disabled="{cannotTake}" on-press="take_control" label="{humanSegment}">Tu</button>
                <button size="sm" selected="{grok}" disabled="{cannotGrokSegment}" on-press="release_control" label="{grokSegment}">Grok</button>
              </toggle-group>
              <spacer width="4"/>
            </if>
            <button size="sm" variant="ghost" icon="edit" label="Rinomina sessione" on-press="rename_session"/>
            <if test="{alive}"><button size="sm" variant="ghost" icon="external-link" label="Apri in Terminale" disabled="{busy}" on-press="open_terminal"/></if>
            <button size="sm" variant="ghost" icon="info" label="Dettagli sessione" selected="{details}" on-press="show_details"/>
            <if test="{alive}"><button size="sm" variant="outline" icon="pause" disabled="{cannotStop}" on-press="stop_session">Chiudi CLI</button></if>
          </else>
          <spacer width="14"/>
        </row>
        <separator/>
        <if test="{attention}">
          <row padding="14" gap="12" cross="center" background="surface">
            <column width="3" height="34" radius="sm" background="warning"/>
            <icon name="alert" foreground="warning" width="18" height="18"/>
            <column grow="1" gap="2">
              <text>{attentionTitle}</text>
              <text size="sm" wrap="true" foreground="text_muted">{attentionHint}</text>
            </column>
            <if test="{grok}"><button size="sm" variant="primary" disabled="{busy}" on-press="take_control">Prendi il controllo</button></if>
          </row>
          <separator/>
        </if>
        <else>
          <if test="{showGrokBanner}">
            <row padding="14" gap="12" cross="center" background="surface">
              <column width="3" height="34" radius="sm" background="info"/>
              <icon name="eye" foreground="info" width="18" height="18"/>
              <column grow="1" gap="2">
                <text>Grok ha il controllo</text>
                <text size="sm" wrap="true" foreground="text_muted">Stai osservando: il terminale è in sola lettura finché non prendi il controllo.</text>
              </column>
              <button size="sm" variant="primary" disabled="{busy}" on-press="take_control">Prendi il controllo</button>
            </row>
            <separator/>
          </if>
          <if test="{showControlHint}">
            <row padding="10" gap="10" cross="center" background="surface">
              <spinner width="12" height="12"/>
              <text size="sm" grow="1" foreground="text_muted">{controlHint}</text>
            </row>
            <separator/>
          </if>
        </else>
        <row grow="1" gap="0">
          <if test="{terminalVisible}">
            <column grow="1" padding="10">
              <terminal key="agent-terminal" pty="{ptyKey}" scrollback="{scrollback}" grow="1" label="Terminale della sessione" on-terminal="terminal_state" autofocus="{focus_terminal}"/>
            </column>
          </if>
          <else>
            <column grow="1" padding="40" main="center" cross="center">
              <column width="460" gap="14" cross="center">
                <if test="{archived}">
                  <row width="56" height="56" radius="xl" background="surface_subtle" main="center" cross="center"><icon name="archive" foreground="text_muted" width="26" height="26"/></row>
                  <text size="heading">Sessione archiviata</text>
                  <text wrap="true" text-alignment="center" foreground="text_muted">La conversazione è conservata. Ripristinala per riprenderla dallo stesso punto.</text>
                  <button icon="archive" variant="primary" on-press="restore_session" disabled="{busy}">Ripristina dall'archivio</button>
                </if>
                <else>
                  <row width="56" height="56" radius="xl" background="surface_subtle" main="center" cross="center"><icon name="pause" foreground="text_muted" width="26" height="26"/></row>
                  <text size="heading">Sessione chiusa</text>
                  <if test="{human}">
                    <text wrap="true" text-alignment="center" foreground="text_muted">La conversazione è conservata. Riprendila per continuare esattamente da dove si era fermata.</text>
                    <row gap="8">
                      <button icon="play" variant="primary" disabled="{cannotStart}" on-press="start_session">Riprendi sessione</button>
                      <button icon="archive" variant="ghost" disabled="{busy}" on-press="archive_session">Archivia</button>
                    </row>
                  </if>
                  <else>
                    <text wrap="true" text-alignment="center" foreground="text_muted">Grok ha il controllo di questa sessione. Prendi il controllo per riprenderla tu.</text>
                    <row gap="8">
                      <button variant="primary" disabled="{busy}" on-press="take_control">Prendi il controllo</button>
                      <button icon="play" variant="outline" disabled="{cannotStart}" on-press="start_session">Riprendi sessione</button>
                    </row>
                  </else>
                </else>
                <text size="sm" foreground="text_muted">{closedMeta}</text>
              </column>
            </column>
          </else>
          <if test="{detailsVisible}">
            <separator/>
            <scroll width="300">
              <column padding="18" gap="16">
                <row cross="center"><text grow="1">Dettagli</text><button size="sm" variant="ghost" icon="x" label="Chiudi dettagli" on-press="show_details"/></row>
                <column gap="6">
                  <text size="sm" foreground="text_muted">Conversazione originale</text>
                  <text><span mono="true">{nativeId}</span></text>
                  <if test="{hasNativeId}"><button size="sm" variant="outline" icon="copy" on-press="copy_id">Copia ID</button></if>
                </column>
                <column gap="6">
                  <text size="sm" foreground="text_muted">Sessione Harbor</text>
                  <text><span mono="true">{selectedId}</span></text>
                </column>
                <use template="inspector-field" title="Agente" value="{selectedProvider}"/>
                <use template="inspector-field" title="Cartella di lavoro" value="{selectedProject}"/>
                <use template="inspector-field" title="Controllo" value="{controlLabel}"/>
                <use template="inspector-field" title="Processo" value="{pidLabel}"/>
                <use template="inspector-field" title="Esecuzione" value="{runLabel}"/>
                <use template="inspector-field" title="Creata" value="{createdLabel}"/>
                <use template="inspector-field" title="Ultimo aggiornamento" value="{updatedLabel}"/>
                <if test="{hasErrorCode}"><use template="inspector-field" title="Ultimo segnale" value="{errorCode}"/></if>
                <if test="{alive}"><button size="sm" variant="outline" icon="refresh-cw" on-press="reconnect">Ricollega terminale</button></if>
                <separator/>
                <text size="sm" wrap="true" foreground="text_muted">Apri in Terminale usa la stessa CLI e lo stesso contesto, anche per funzioni di input avanzate. Chiudere la finestra non ferma le sessioni.</text>
              </column>
            </scroll>
          </if>
        </row>
      </if>
      <else>
        <row height="{headerHeight}" window-drag="true" background="background"><spacer grow="1"/></row>
        <scroll grow="1">
          <column grow="1" padding="40" main="center" cross="center">
            <if test="{showWelcome}">
              <column width="580" gap="26">
                <column gap="10">
                  <row width="48" height="48" radius="xl" background="surface_subtle" main="center" cross="center"><icon name="terminal" foreground="accent" width="24" height="24"/></row>
                  <text size="heading">Il lavoro continua, anche a finestra chiusa</text>
                  <text wrap="true" foreground="text_muted">Avvia Claude Code o Codex in una sessione persistente, segui il lavoro e passa il controllo a Grok quando vuoi.</text>
                </column>
                <row gap="12">
                  <card grow="1" height="72" padding="14" on-press="new_claude" role="button" label="Nuova sessione con Claude Code">
                    <row gap="12" cross="center"><avatar label="Claude Code">CC</avatar><column grow="1" gap="2"><text>Claude Code</text><text size="sm" foreground="text_muted">Nuova sessione</text></column><icon name="arrow-right" foreground="text_muted" width="16" height="16"/></row>
                  </card>
                  <card grow="1" height="72" padding="14" on-press="new_codex" role="button" label="Nuova sessione con Codex">
                    <row gap="12" cross="center"><avatar label="Codex">CX</avatar><column grow="1" gap="2"><text>Codex</text><text size="sm" foreground="text_muted">Nuova sessione</text></column><icon name="arrow-right" foreground="text_muted" width="16" height="16"/></row>
                  </card>
                </row>
                <column gap="14">
                  <use template="feature" icon="refresh-cw" title="Riprendi la conversazione esatta" detail="Ogni sessione riparte dalla sua conversazione originale, mai dalla più recente."/>
                  <use template="feature" icon="send" title="Passa il controllo a Grok" detail="Osserva il lavoro del bot e riprendi il controllo in qualsiasi momento."/>
                  <use template="feature" icon="eye" title="Le sessioni di Grok compaiono qui" detail="Le sessioni avviate dal bot si aggiungono all'elenco automaticamente."/>
                </column>
                <text size="sm" foreground="text_muted">Cmd+N nuova sessione · Cmd+F cerca · Cmd+1-9 apri · Cmd+Opzione+frecce cambia sessione</text>
              </column>
            </if>
            <else>
              <column gap="12" cross="center" padding="80">
                <spinner width="22" height="22"/>
                <text foreground="text_muted">{placeholderText}</text>
              </column>
            </else>
          </column>
        </scroll>
      </else>
    </else>
  </column>
</row>
